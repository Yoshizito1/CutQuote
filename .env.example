# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# Dashboard -> Project Settings -> API
#
# Sem estas variáveis a aplicação ainda roda: usa o catálogo embutido no código
# e mantém o orçamento em memória. Só contas, histórico e edição de catálogo
# ficam indisponíveis.

NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXX

# Ambas são públicas por natureza: vão no bundle enviado ao navegador.
# Quem protege os dados é o Row Level Security, definido em supabase/migrations/.
# NUNCA coloque aqui a service_role key — ela ignora todo o RLS.
